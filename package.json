{
  "name": "la-yeka-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:cliente": "pnpm --filter @la-yeka/client dev",
    "dev:admin": "pnpm --filter @la-yeka/admin dev",
    "dev:api": "pnpm --filter @la-yeka/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm db:generate && pnpm --filter @la-yeka/api typecheck && pnpm --filter @la-yeka/client typecheck && pnpm --filter @la-yeka/admin typecheck",
    "test": "pnpm --filter @la-yeka/api test",
    "verify": "pnpm typecheck && pnpm test && pnpm --filter @la-yeka/client build && pnpm --filter @la-yeka/admin build",
    "db:generate": "pnpm --filter @la-yeka/database generate",
    "db:migrate": "pnpm --filter @la-yeka/database migrate",
    "db:migrate:deploy": "pnpm --filter @la-yeka/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @la-yeka/database seed"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
