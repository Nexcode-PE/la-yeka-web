generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?
  email     String   @unique
  passwordHash String? @map("password_hash")
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  orders    Order[]
  auditLogs AuditLog[]
  orderStatusEvents OrderStatusEvent[]
  @@map("users")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  position  Int       @default(0)
  isAvailable Boolean @default(true) @map("is_available")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]
  @@index([isAvailable, position])
  @@map("categories")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  name        String
  description String?
  price       Decimal   @db.Decimal(8, 2)
  imagePath   String?   @map("image_path")
  isAvailable Boolean   @default(true) @map("is_available")
  isFeatured  Boolean   @default(false) @map("is_featured")
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  @@index([categoryId])
  @@map("products")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  orderNumber   Int         @unique @default(autoincrement()) @map("order_number")
  userId        String?     @map("user_id") @db.Uuid
  customerName  String?     @map("customer_name")
  customerPhone String?     @map("customer_phone")
  fulfillment   FulfillmentMethod @default(DELIVERY)
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paymentReference String? @map("payment_reference")
  paymentReviewedAt DateTime? @map("payment_reviewed_at")
  address       String?
  district      String?
  notes         String?
  total         Decimal     @db.Decimal(8, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusEvents  OrderStatusEvent[]
  @@index([userId])
  @@map("orders")
}

model OrderStatusEvent {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus @map("to_status")
  reason      String?
  changedById String?     @map("changed_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  order       Order       @relation(fields:[orderId], references:[id], onDelete:Cascade)
  changedBy   User?       @relation(fields:[changedById], references:[id], onDelete:SetNull)
  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  productName String   @map("product_name")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(8, 2)
  quantity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Claim {
  id            String   @id @default(uuid()) @db.Uuid
  customerName  String   @map("customer_name")
  document      String
  email         String
  phone         String
  kind          ClaimKind
  orderReference String? @map("order_reference")
  detail        String
  requestedSolution String @map("requested_solution")
  status        ClaimStatus @default(RECEIVED)
  adminResponse String?  @map("admin_response")
  respondedAt   DateTime? @map("responded_at")
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@map("claims")
}

model StoreSettings {
  id           String   @id @default("main")
  businessName String   @default("La Yeka") @map("business_name")
  whatsapp     String   @default("51974121550")
  address      String   @default("Calle Mariscal Benavides 150, Chincha Alta")
  district     String   @default("Chincha Alta")
  openingHours String   @default("Todos los días · 6:00 p. m. a 11:00 p. m.") @map("opening_hours")
  deliveryNote String   @default("Confirma cobertura y tiempo de entrega por WhatsApp.") @map("delivery_note")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("store_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")
  admin      User?    @relation(fields:[adminId], references:[id], onDelete:SetNull)
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  YAPE
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ClaimKind {
  COMPLAINT
  SERVICE_ISSUE
}

enum ClaimStatus {
  RECEIVED
  IN_REVIEW
  RESOLVED
}
