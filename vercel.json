{
  "buildCommand": "pnpm --filter @la-yeka/client build",
  "outputDirectory": "apps/client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route]"
    }
  ],
  "functions": {
    "api/[...route].ts": {
      "includeFiles": "packages/database/**"
    }
  }
}
